#!/bin/sh

. "$(dirname "$0")/e2e-test-subrs"
if ! set_locale; then
    echo "$0: no usable locale" >&2
    exit 99
fi

set -eu
out=$(
    TERM=vt100 \
        ./inpty \
        ../../scripts/mosh \
        --client="../frontend/mosh-client" \
        --server="$PWD/../frontend/mosh-server" \
        --local --bind-server=127.0.0.1 127.0.0.1 \
        -- sh -c 'printf "he%s\nTERM=%s\n" llo "$TERM"')
case "$out" in
    *hello*TERM=vt100*) exit 0;;
    *) exit 1;;
esac
